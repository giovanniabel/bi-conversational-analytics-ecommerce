# ClickHouse Connection
# Use "localhost" when running the app on your host machine, or the
# service name (e.g. "clickhouse") when running inside the same
# Docker network as the ClickHouse container.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123
CLICKHOUSE_DATABASE=olist

# LLM Configuration (via LangChain — provider is swappable)
# LLM_PROVIDER: one of gemini | openai | anthropic
# LLM_MODEL examples:
#   gemini    -> gemini-2.5-flash, gemini-2.5-pro
#   openai    -> gpt-4o-mini, gpt-4o
#   anthropic -> claude-sonnet-5, claude-haiku-4-5
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.5-flash

# Metabase (used by the FastAPI web UI at :8000)
# INTERNAL is how the backend reaches Metabase; PUBLIC is what the browser
# loads iframes from. Inside Docker, compose overrides INTERNAL to
# http://metabase:3000 — leave PUBLIC pointing at wherever *you* open
# Metabase in a browser.
METABASE_INTERNAL_URL=http://localhost:3000
METABASE_PUBLIC_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=metabase123!
METABASE_SITE_NAME=E-commerce Analytics
METABASE_DATABASE_NAME=Olist ClickHouse
METABASE_DASHBOARD_NAME=Sales Overview
# Optional. Left blank, the app reads Metabase's own auto-generated embedding
# secret over the API, which is what makes inline dashboards work with no setup.
METABASE_EMBEDDING_SECRET=

# Application
LOG_LEVEL=INFO
MAX_CONVERSATION_HISTORY=10
MAX_SQL_RETRY_ATTEMPTS=3
MAX_RESULT_ROWS_FOR_LLM=200

# Kaggle API (used once, by scripts/download_dataset.sh, to fetch the
# Olist dataset — not read by the app itself). Get these from
# https://www.kaggle.com/settings -> API -> Create New Token.
KAGGLE_USERNAME=
KAGGLE_KEY=
